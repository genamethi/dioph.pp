# Vendored native dependencies.
#
# Policy: no pins — every submodule tracks its upstream branch head
# (`git submodule update --remote`). native/configure populates any empty
# submodule at the branch head and builds/installs it into the prefix when
# the prefix doesn't already provide it.
[submodule "native/vendor/lmdb"]
	path = native/vendor/lmdb
	url = https://github.com/LMDB/lmdb
	branch = mdb.master3
	shallow = true

[submodule "native/vendor/iceberg-cpp"]
	path = native/vendor/iceberg-cpp
	url = https://github.com/apache/iceberg-cpp
	branch = main
	shallow = true
	ignore = all

[submodule "native/vendor/arrow"]
	path = native/vendor/arrow
	url = https://github.com/apache/arrow
	branch = main
	shallow = true

[submodule "native/vendor/flint"]
	path = native/vendor/flint
	url = https://github.com/flintlib/flint
	branch = main
	shallow = true

[submodule "native/vendor/notcurses"]
	path = native/vendor/notcurses
	url = https://github.com/dankamongmen/notcurses
	branch = master
	shallow = true

[submodule "iceberg-spec"]
	path = docs/vendor/iceberg
	url = https://github.com/apache/iceberg
	branch = main

[submodule "native/vendor/ginac"]
	path = native/vendor/ginac
  url = https://github.com/AlexeiSheplyakov/GiNaC
  branch = main
	shallow = true
	ignore = all
