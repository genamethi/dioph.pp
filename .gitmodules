# Vendored native dependencies.
#
# Policy: pinned — every submodule is recorded at an exact commit and
# native/configure populates it at that commit. `branch` is the upstream
# tracking branch for a deliberate bump (`git submodule update --remote
# <path>` followed by `git add <path>`), never what a checkout resolves to.
[submodule "native/vendor/lmdb"]
	path = native/vendor/lmdb
	url = https://github.com/LMDB/lmdb
	branch = mdb.master3
	shallow = true

[submodule "native/vendor/iceberg-cpp"]
	path = native/vendor/iceberg-cpp
	url = https://github.com/apache/iceberg-cpp
	branch = main
	shallow = true

[submodule "native/vendor/arrow"]
	path = native/vendor/arrow
	url = https://github.com/apache/arrow
	branch = main
	shallow = true

[submodule "native/vendor/flint"]
	path = native/vendor/flint
	url = https://github.com/flintlib/flint
	branch = main
	shallow = true

[submodule "iceberg-spec"]
	path = docs/vendor/iceberg
	url = https://github.com/apache/iceberg
	branch = main

