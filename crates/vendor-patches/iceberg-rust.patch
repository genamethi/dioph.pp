# primeparts vendor patches against iceberg-rust v0.9.0.
#
# Upstream tree: native/vendor/iceberg-rust/
# Apply with:    patch -p1 < this-file   (cwd = vendor tree root)
# Applied via:   scripts/apply_vendor_patches.sh (idempotent, sentinel-based)
#
# Patch A - crates/iceberg/src/writer/file_writer/parquet_writer.rs
#   Visibility flip on parquet_to_data_file_builder so primeparts-core can
#   call it directly and stamp .sort_order_id(default_sort_order_id) on the
#   returned DataFileBuilder before .build(). The wrapper
#   parquet_files_to_data_files (line 312) intentionally not flipped: it
#   never sets sort_order_id and our per-file loop in
#   primeparts-core::data_file replaces it. Mirrors pyiceberg patch
#   _patch_pyiceberg_sort_order_id in src/primeparts/_patches.py.
#   Remove when upstream lands a builder that reads sort_order_id from
#   TableMetadata.
#
# Patch B - crates/catalog/hms/src/catalog.rs
#   Hive Metastore 4 dropped the deprecated `get_table(db, tbl)` thrift
#   method; calls fail with `Invalid method name: 'get_table'`. The
#   modern call is `get_table_req(GetTableRequest)`, returning
#   GetTableResult { table: Table }. We swap all three call sites
#   (load_table, table_exists, rename_table), update the imports, and swap
#   the table_exists pattern match's exception variant to the new
#   ThriftHiveMetastoreGetTableReqException (same O1/O2 shape as the old
#   one). Mirrors pyiceberg patch _patch_hive_metastore_get_table.
#   Remove when upstream migrates to get_table_req natively.

diff --git a/crates/iceberg/src/writer/file_writer/parquet_writer.rs b/crates/iceberg/src/writer/file_writer/parquet_writer.rs
--- a/crates/iceberg/src/writer/file_writer/parquet_writer.rs
+++ b/crates/iceberg/src/writer/file_writer/parquet_writer.rs
@@ -347,7 +347,7 @@
     }
 
     /// `ParquetMetadata` to data file builder
-    pub(crate) fn parquet_to_data_file_builder(
+    pub fn parquet_to_data_file_builder(
         schema: SchemaRef,
         metadata: Arc<ParquetMetaData>,
         written_size: usize,
diff --git a/crates/catalog/hms/src/catalog.rs b/crates/catalog/hms/src/catalog.rs
--- a/crates/catalog/hms/src/catalog.rs
+++ b/crates/catalog/hms/src/catalog.rs
@@ -23,8 +23,8 @@
 use anyhow::anyhow;
 use async_trait::async_trait;
 use hive_metastore::{
-    ThriftHiveMetastoreClient, ThriftHiveMetastoreClientBuilder,
-    ThriftHiveMetastoreGetDatabaseException, ThriftHiveMetastoreGetTableException,
+    GetTableRequest, ThriftHiveMetastoreClient, ThriftHiveMetastoreClientBuilder,
+    ThriftHiveMetastoreGetDatabaseException, ThriftHiveMetastoreGetTableReqException,
 };
 use iceberg::io::{FileIO, FileIOBuilder, StorageFactory};
 use iceberg::spec::{TableMetadata, TableMetadataBuilder};
@@ -550,10 +550,15 @@
         let hive_table = self
             .client
             .0
-            .get_table(db_name.clone().into(), table.name.clone().into())
+            .get_table_req(GetTableRequest {
+                db_name: db_name.clone().into(),
+                tbl_name: table.name.clone().into(),
+                capabilities: None,
+            })
             .await
             .map(from_thrift_exception)
-            .map_err(from_thrift_error)??;
+            .map_err(from_thrift_error)??
+            .table;
 
         let metadata_location = get_metadata_location(&hive_table.parameters)?;
 
@@ -629,12 +634,16 @@
         let resp = self
             .client
             .0
-            .get_table(db_name.into(), table_name.into())
+            .get_table_req(GetTableRequest {
+                db_name: db_name.into(),
+                tbl_name: table_name.into(),
+                capabilities: None,
+            })
             .await;
 
         match resp {
             Ok(MaybeException::Ok(_)) => Ok(true),
-            Ok(MaybeException::Exception(ThriftHiveMetastoreGetTableException::O2(_))) => Ok(false),
+            Ok(MaybeException::Exception(ThriftHiveMetastoreGetTableReqException::O2(_))) => Ok(false),
             Ok(MaybeException::Exception(exception)) => Err(Error::new(
                 ErrorKind::Unexpected,
                 "Operation failed for hitting thrift error".to_string(),
@@ -666,10 +675,15 @@
         let mut tbl = self
             .client
             .0
-            .get_table(src_dbname.clone().into(), src_tbl_name.clone().into())
+            .get_table_req(GetTableRequest {
+                db_name: src_dbname.clone().into(),
+                tbl_name: src_tbl_name.clone().into(),
+                capabilities: None,
+            })
             .await
             .map(from_thrift_exception)
-            .map_err(from_thrift_error)??;
+            .map_err(from_thrift_error)??
+            .table;
 
         tbl.db_name = Some(dest_dbname.into());
         tbl.table_name = Some(dest_tbl_name.into());
