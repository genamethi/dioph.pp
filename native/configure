#!/usr/bin/env sh
set -e

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
VENDOR="$ROOT/vendor"
PREFIX="${PREFIX:-/usr/local}"
JOBS=$(nproc 2>/dev/null || echo 4)
CXX="${CXX:-g++}"

SUDO=
[ "$(id -u)" = 0 ] || SUDO=sudo

SANITIZE=
SANITIZE_VENDOR=
VENDOR_FLINT=
FORCE=
DISTCLEAN=
for arg in "$@"; do
  case "$arg" in
    --sanitize) SANITIZE=1 ;;
    --sanitize-vendor)
      SANITIZE=1
      SANITIZE_VENDOR=1
      ;;
    --vendor-flint) VENDOR_FLINT=1 ;;
    --force) FORCE=1 ;;
    --distclean) DISTCLEAN=1 ;;
    *)
      echo "unknown option: $arg (supported: --sanitize, --sanitize-vendor, --vendor-flint, --force, --distclean)"
      exit 1
      ;;
  esac
done

if [ -n "$DISTCLEAN" ]; then
  rm -rf "$VENDOR/arrow/cpp/build" "$VENDOR/iceberg-cpp/build" "$ROOT/build" "$ROOT/config.mk"
  if [ -f "$VENDOR/flint/Makefile" ]; then
    make -C "$VENDOR/flint" distclean >/dev/null 2>&1 || true
  fi
  find "$VENDOR/lmdb" -name '*.o' -delete 2>/dev/null || true
  echo "distclean: removed vendor build trees, $ROOT/build and config.mk"
  echo "prefix artifacts under $PREFIX are untouched; rerun with --force to overwrite them"
  exit 0
fi

have_pc() {
  command -v pkg-config >/dev/null 2>&1 || return 1
  PKG_CONFIG_PATH="$PREFIX/lib/pkgconfig:$PKG_CONFIG_PATH" pkg-config --exists "$1"
}

if [ -n "$SANITIZE_VENDOR" ] && [ "$PREFIX" = "/usr/local" ]; then
  echo "--sanitize-vendor builds instrumented arrow/iceberg and would overwrite the release prefix."
  echo "set PREFIX to a separate prefix, e.g. PREFIX=\$HOME/.local/pp-asan ./configure --sanitize-vendor"
  exit 1
fi

ARROW_SAN_FLAGS=
ICEBERG_SAN_FLAGS=
if [ -n "$SANITIZE_VENDOR" ]; then
  ARROW_SAN_FLAGS="-DARROW_USE_ASAN=ON -DARROW_USE_UBSAN=ON"
  ICEBERG_SAN_FLAGS="-DICEBERG_ENABLE_ASAN=ON -DICEBERG_ENABLE_UBSAN=ON"
fi

DISTRO=
if command -v pacman >/dev/null 2>&1; then
  DISTRO=arch
  command -v yay >/dev/null 2>&1 || {
    echo "yay required (arch target)"
    exit 1
  }
  PKGS="base-devel pkgconf cmake ninja git curl tar unzip boost \
gmp mpfr pari primesieve primecount sqlite openssl \
nlohmann-json3.12-dev \
ginac notcurses \
thrift brotli protobuf abseil-cpp re2 utf8proc lz4 zstd zlib bzip2"

  if [ -n "$VENDOR_FLINT" ]; then
    PKGS="$PKGS autoconf automake libtool"
  else
    have_pc flint || PKGS="$PKGS flint"
  fi

  missing=
  for p in $PKGS; do
    pacman -Qq "$p" >/dev/null 2>&1 || pacman -Qg "$p" >/dev/null 2>&1 || missing="$missing $p"
  done
  [ -n "$missing" ] && yay -S --needed $missing || echo "system deps present"
elif command -v apt-get >/dev/null 2>&1; then
  DISTRO=debian
  deb_have() { dpkg-query -W -f '${Status}' "$1" 2>/dev/null | grep -q "install ok installed"; }

  PKGS="build-essential pkgconf cmake ninja-build git curl tar unzip \
libboost-dev libgmp-dev libmpfr-dev libprimesieve-dev libprimecount-dev \
libsqlite3-dev libssl-dev libreadline-dev libginac-dev nlohmann-json3.12-dev \
zlib1g-dev libzstd-dev libbz2-dev libbrotli-dev"

  deb_have libcurl4-openssl-dev || deb_have libcurl4-gnutls-dev || PKGS="$PKGS libcurl4-openssl-dev"
  [ -e "$PREFIX/lib/libpari.so" ] || [ -e "$PREFIX/lib/libpari.a" ] || deb_have libpari-dev || PKGS="$PKGS libpari-dev"
  if [ -n "$VENDOR_FLINT" ]; then
    PKGS="$PKGS autoconf automake libtool"
  else
    have_pc flint || PKGS="$PKGS libflint-dev"
  fi
  have_pc notcurses-core || PKGS="$PKGS libnotcurses-dev"

  missing=
  for p in $PKGS; do deb_have "$p" || missing="$missing $p"; done
  if [ -n "$missing" ]; then
    $SUDO apt-get update
    $SUDO apt-get install -y $missing
  else
    echo "system deps present"
  fi
else
  echo "unsupported distro: need pacman (arch) or apt-get (debian)"
  exit 1
fi

printf '#include <format>\n#include <ranges>\n#include <vector>\n#include <expected>\nint main(){auto v=std::views::iota(0,1)|std::ranges::to<std::vector<int>>();return (int)std::format("{}",v.size()).size();}\n' |
  "$CXX" -std=c++23 -x c++ - -o "$(mktemp -u)" 2>/dev/null ||
  {
    echo "toolchain lacks c++23 <format>/std::ranges::to/<expected> (need gcc>=14); set CXX="
    exit 1
  }
echo "c++23 toolchain ok"

for t in cmake ninja make git curl tar pkg-config; do
  command -v "$t" >/dev/null 2>&1 || {
    echo "missing tool: $t"
    exit 1
  }
done

REPO=$(cd "$ROOT/.." && pwd -P)
vendor_sync() {
  [ -e "$VENDOR/$1/.git" ] ||
    git -C "$REPO" submodule update --init -- "native/vendor/$1"
}

prefix_stamp() { echo "$PREFIX/lib/.pp-$1.sha"; }

vendor_token() {
  vt=$(git -C "$VENDOR/$1" rev-parse HEAD)
  [ "$1" != iceberg-cpp ] || vt="$vt nlohmann-${PREFIX_NLOHMANN:-default}"
  echo "$vt"
}

prefix_matches_vendor() {
  [ -e "$VENDOR/$1/.git" ] || return 0
  [ "$(cat "$(prefix_stamp "$1")" 2>/dev/null || true)" = "$(vendor_token "$1")" ]
}

needs_install() {
  [ -z "$FORCE" ] || return 0
  [ -f "$2" ] || return 0
  if prefix_matches_vendor "$1"; then return 1; fi
  echo "$1 in $PREFIX does not match the vendored pin; rebuilding"
  return 0
}

stamp_prefix() {
  [ -e "$VENDOR/$1/.git" ] || return 0
  vendor_token "$1" | $SUDO tee "$(prefix_stamp "$1")" >/dev/null
}

nlohmann_version() {
  [ -f "$1" ] || return 0
  awk '/define NLOHMANN_JSON_VERSION_MAJOR/ { M = $3 }
       /define NLOHMANN_JSON_VERSION_MINOR/ { m = $3 }
       /define NLOHMANN_JSON_VERSION_PATCH/ { p = $3 }
       END { if (M != "") print M "." m "." p }' "$1"
}

vendor_sync lmdb

SPEC_SM="$REPO/docs/vendor/iceberg"
if [ ! -e "$SPEC_SM/.git" ]; then
  git -C "$REPO" submodule update --init -- docs/vendor/iceberg
fi
if [ -e "$SPEC_SM/.git" ] && [ "$(git -C "$SPEC_SM" config core.sparseCheckout)" != "true" ]; then
  git -C "$SPEC_SM" sparse-checkout init --cone
  git -C "$SPEC_SM" sparse-checkout set open-api
fi
if [ -f "$SPEC_SM/open-api/rest-catalog-open-api.yaml" ]; then
  echo "iceberg openapi spec present"
else
  echo "iceberg openapi spec missing ($SPEC_SM/open-api/rest-catalog-open-api.yaml)"
  exit 1
fi

if [ -n "$VENDOR_FLINT" ] && needs_install flint "$PREFIX/lib/pkgconfig/flint.pc"; then
  vendor_sync flint
  cd "$VENDOR/flint"
  [ -x configure ] || ./bootstrap.sh
  ./configure --prefix="$PREFIX"
  make -j "$JOBS"
  $SUDO make install
  cd "$ROOT"
  stamp_prefix flint
elif have_pc flint; then
  echo "flint present"
else
  echo "flint missing (no flint.pc); install the distro flint dev package or rerun with --vendor-flint"
  exit 1
fi

if have_pc notcurses-core; then
  echo "notcurses present"
else
  echo "notcurses missing (no notcurses-core.pc); install the distro notcurses dev package"
  exit 1
fi

if [ ! -x /usr/local/bin/lua ] || ! /usr/local/bin/lua -v 2>&1 | grep -q "Lua 5.5"; then
  tmp=$(mktemp -d)
  cd "$tmp"
  curl -L -R -O https://www.lua.org/ftp/lua-5.5.0.tar.gz
  tar zxf lua-5.5.0.tar.gz
  cd lua-5.5.0
  make all test
  $SUDO make install
  cd "$ROOT"
  rm -rf "$tmp"
else
  echo "lua 5.5 present"
fi

httplib_ok=
for f in "$PREFIX/include/httplib.h" /usr/local/include/httplib.h /usr/include/httplib.h; do
  [ -f "$f" ] || continue
  grep -q 'inline Server::Server' "$f" && httplib_ok=1
  break
done
if [ -z "$httplib_ok" ]; then
  tag=$(curl -fsSL https://api.github.com/repos/yhirose/cpp-httplib/releases/latest |
    sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')
  [ -n "$tag" ] || {
    echo "could not resolve latest cpp-httplib release"
    exit 1
  }
  tmp=$(mktemp)
  curl -fsSL "https://raw.githubusercontent.com/yhirose/cpp-httplib/$tag/httplib.h" -o "$tmp"
  grep -q 'inline Server::Server' "$tmp" || {
    echo "fetched cpp-httplib $tag is not header-only"
    exit 1
  }
  $SUDO mkdir -p "$PREFIX/include"
  $SUDO cp "$tmp" "$PREFIX/include/httplib.h"
  rm -f "$tmp"
  echo "cpp-httplib $tag (header-only) installed to $PREFIX/include"
else
  echo "cpp-httplib header-only present"
fi

if needs_install arrow "$PREFIX/lib/libarrow.a"; then
  vendor_sync arrow
  cd "$VENDOR/arrow/cpp"
  mkdir -p build
  cd build
  cmake .. --preset ninja-release -DCMAKE_INSTALL_PREFIX="$PREFIX" \
    -DARROW_BUILD_STATIC=ON -DARROW_DEPENDENCY_SOURCE=BUNDLED \
    -DARROW_WITH_SNAPPY=ON -DARROW_BUILD_UTILITIES=ON -DARROW_TESTING=ON \
    $ARROW_SAN_FLAGS
  ninja -j "$JOBS"
  $SUDO cmake --install .
  cd "$ROOT"
  stamp_prefix arrow
else
  echo "arrow static present"
fi

if [ ! -f "$PREFIX/include/arrow-gtest/gtest/gtest.h" ]; then
  echo "arrow's bundled gtest missing ($PREFIX/include/arrow-gtest/gtest/gtest.h); rebuild arrow with -DARROW_TESTING=ON"
  exit 1
fi
echo "arrow-gtest bundle present"

NLOHMANN_VERSION=$(nlohmann_version "$PREFIX/include/nlohmann/detail/abi_macros.hpp")
[ -n "$NLOHMANN_VERSION" ] ||
  NLOHMANN_VERSION=$(nlohmann_version /usr/include/nlohmann/detail/abi_macros.hpp)
[ -n "$NLOHMANN_VERSION" ] || {
  echo "nlohmann-json headers not found in $PREFIX/include or /usr/include"
  exit 1
}
echo "nlohmann-json $NLOHMANN_VERSION present"

PREFIX_NLOHMANN="$NLOHMANN_VERSION"
ICEBERG_NLOHMANN_JSON_URL="https://github.com/nlohmann/json/releases/download/v$NLOHMANN_VERSION/json.tar.xz"
export ICEBERG_NLOHMANN_JSON_URL
FETCHED_NLOHMANN=$(nlohmann_version \
  "$VENDOR/iceberg-cpp/build/_deps/nlohmann_json-src/include/nlohmann/detail/abi_macros.hpp")
if [ -n "$FETCHED_NLOHMANN" ] && [ "$FETCHED_NLOHMANN" != "$NLOHMANN_VERSION" ]; then
  echo "iceberg build tree fetched nlohmann-json $FETCHED_NLOHMANN, want $NLOHMANN_VERSION; discarding it"
  rm -rf "$VENDOR/iceberg-cpp/build"
fi

if needs_install iceberg-cpp "$PREFIX/lib/libiceberg_sql_catalog.a"; then
  echo "building iceberg against nlohmann-json $NLOHMANN_VERSION"
  vendor_sync iceberg-cpp
  cd "$VENDOR/iceberg-cpp"
  cmake -S . -B build -G Ninja \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" -DCMAKE_PREFIX_PATH="$PREFIX" \
    -DICEBERG_BUILD_BUNDLE=ON -DICEBERG_BUILD_SHARED=ON \
    -DICEBERG_SQL_SQLITE=ON -DICEBERG_BUILD_SQL_CATALOG=ON \
    -DICEBERG_BUILD_REST_INTEGRATION_TESTS=ON \
    $ICEBERG_SAN_FLAGS
  cmake --build build -j "$JOBS"
  $SUDO cmake --install build
  cd "$ROOT"
  stamp_prefix iceberg-cpp
else
  echo "iceberg present"
fi

ICEBERG_SRC="$VENDOR/iceberg-cpp/src"
FALLBACK=
NEED="iceberg/catalog/session_catalog.h iceberg/catalog/session_context.h"
need_cp=
for h in $NEED; do [ -f "$PREFIX/include/$h" ] || need_cp=1; done
if [ -n "$need_cp" ]; then
  $SUDO mkdir -p "$PREFIX/include/iceberg/catalog" 2>/dev/null || true
  $SUDO cp "$ICEBERG_SRC"/iceberg/catalog/*.h "$PREFIX/include/iceberg/catalog/" 2>/dev/null || true
  for h in $NEED; do [ -f "$PREFIX/include/$h" ] || FALLBACK=1; done
  [ -n "$FALLBACK" ] && echo "warn: could not install catalog headers to prefix; using vendored src include" || echo "catalog headers installed to prefix"
else
  echo "iceberg catalog headers present"
fi

DUCKDB="$(command -v duckdb 2>/dev/null || true)"
[ -x "$DUCKDB" ] || DUCKDB="$HOME/.duckdb/cli/latest/duckdb"
if [ ! -x "$DUCKDB" ]; then
  curl -fsSL https://install.duckdb.org | sh
  DUCKDB="$HOME/.duckdb/cli/latest/duckdb"
fi
[ -x "$DUCKDB" ] || {
  echo "duckdb install failed (expected $DUCKDB)"
  exit 1
}
echo "duckdb present: $("$DUCKDB" --version)"

duckdb_ext_installed() {
  [ "$("$DUCKDB" -csv -noheader -c \
    "SELECT count(*) FROM duckdb_extensions() WHERE extension_name='$1' AND installed;" \
    2>/dev/null)" = "1" ]
}
if duckdb_ext_installed iceberg && duckdb_ext_installed substrait; then
  echo "duckdb iceberg + substrait extensions present"
else
  "$DUCKDB" -c \
    "INSTALL iceberg; INSTALL substrait FROM community; LOAD iceberg; LOAD substrait;" || {
    echo "duckdb extension install failed (iceberg / substrait FROM community)"
    exit 1
  }
  echo "duckdb iceberg + substrait extensions installed"
fi

if [ ! -f "$PREFIX/include/duckdb.hpp" ] || [ ! -f "$PREFIX/lib/libduckdb.so" ]; then
  DUCKDB_VER="$("$DUCKDB" --version 2>/dev/null | awk '{print $1}')"
  [ -n "$DUCKDB_VER" ] || {
    echo "could not resolve duckdb version for libduckdb bundle"
    exit 1
  }
  case "$(uname -m)" in
  x86_64) DUCKDB_ARCH=amd64 ;;
  aarch64 | arm64) DUCKDB_ARCH=arm64 ;;
  *)
    echo "unsupported arch for libduckdb bundle: $(uname -m)"
    exit 1
    ;;
  esac
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/libduckdb.zip" \
    "https://github.com/duckdb/duckdb/releases/download/$DUCKDB_VER/libduckdb-linux-$DUCKDB_ARCH.zip" || {
    echo "libduckdb bundle download failed ($DUCKDB_VER / $DUCKDB_ARCH)"
    exit 1
  }
  (cd "$tmp" && unzip -oq libduckdb.zip)
  $SUDO cp -p "$tmp/libduckdb.so" "$tmp/libduckdb_static.a" "$PREFIX/lib/"
  $SUDO cp -p "$tmp/duckdb.hpp" "$tmp/duckdb.h" "$PREFIX/include/"
  $SUDO ldconfig 2>/dev/null || true
  rm -rf "$tmp"
  echo "libduckdb $DUCKDB_VER installed to $PREFIX"
else
  echo "libduckdb present"
fi

{
  echo "# generated by native/configure"
  echo "PREFIX := $PREFIX"
  [ -n "$FALLBACK" ] && echo "ICEBERG_FALLBACK_CPPFLAGS := -I$ICEBERG_SRC"
  [ -n "$SANITIZE" ] && echo "SANITIZE := -fsanitize=address,undefined -fno-omit-frame-pointer"
} >"$ROOT/config.mk"

INSTALL_PATH="${PP_INSTALL_PATH:-$HOME/.local/bin}"
case ":$PATH:" in
*":$INSTALL_PATH:"*) ;;
*) echo "warn: install dir $INSTALL_PATH not in PATH (installed binaries won't be found until you add it)" ;;
esac

echo "done. build:  make -C $ROOT   install:  make -C $ROOT install"
