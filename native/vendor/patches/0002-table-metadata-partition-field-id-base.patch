# (kLegacyPartitionDataIdStart - 1) so partition IDs don't collide with reserved
# manifest_entry field IDs.
# RETIRE WHEN: upstream adopts the 1000-base for fresh partition specs.
#
diff --git a/src/iceberg/table_metadata.cc b/src/iceberg/table_metadata.cc
