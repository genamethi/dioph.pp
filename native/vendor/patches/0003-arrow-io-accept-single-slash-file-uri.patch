# primeparts patch 3/3 — accept single-slash file:/ URIs in ResolvePath.
# Hive/Hadoop emit file:/abs/path (single slash); arrow PathFromUri only accepts
# file://. Without this, native iceberg-cpp cannot scan any Hive-created table.
# RETIRE WHEN: ResolvePath (or arrow PathFromUri) handles single-slash file:/.
#
diff --git a/src/iceberg/arrow/arrow_io.cc b/src/iceberg/arrow/arrow_io.cc
index 45ad425..8f5fc11 100644
--- a/src/iceberg/arrow/arrow_io.cc
+++ b/src/iceberg/arrow/arrow_io.cc
@@ -477,6 +477,13 @@ Result<std::string> ArrowFileSystemFileIO::ResolvePath(const std::string& file_l
     ICEBERG_ARROW_ASSIGN_OR_RETURN(auto path, arrow_fs_->PathFromUri(file_location));
     return path;
   }
+  // primeparts: Hive/Hadoop emit single-slash file:/ URIs (e.g. file:/media/...).
+  // Arrow's PathFromUri only accepts the authority form file://, so strip the
+  // bare scheme to hand LocalFileSystem a plain absolute path. Without this,
+  // native iceberg-cpp cannot scan any Hive-created table.
+  if (file_location.starts_with("file:/") && !file_location.starts_with("file://")) {
+    return file_location.substr(5);  // drop the leading "file:", keep "/abs/path"
+  }
   return file_location;
 }
 
