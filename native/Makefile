.DEFAULT_GOAL := all
.PHONY: all clean test e2e build-deps install install-service

CONFIGURE_FLAGS ?=

PP_INSTALL_PATH ?= $(HOME)/.local/bin

CATALOGD_UNIT_NAME := primeparts-catalogd.service
SYSTEMD_USER_DIR := $(HOME)/.local/share/systemd/user

INSTALL_BINS := \
     $(BUILD_DIR)/primeparts-generate \
     $(BUILD_DIR)/pp \
     $(BUILD_DIR)/primeparts-catalogd \
     $(BUILD_DIR)/primeparts-tui \
     $(BUILD_DIR)/primeparts-verify \
     $(BUILD_DIR)/pp-graph

build-deps:
	./configure $(CONFIGURE_FLAGS)

install: all
	mkdir -p "$(PP_INSTALL_PATH)"
	cp $(INSTALL_BINS) "$(PP_INSTALL_PATH)/"
	@if [ ! -f "$(PP_INSTALL_PATH)/config.lua" ]; then \
	  cp $(EXAMPLE_CONFIG_LUA) "$(PP_INSTALL_PATH)/config.lua"; \
	  echo "seeded $(PP_INSTALL_PATH)/config.lua"; \
	fi
	@echo "installed $(words $(INSTALL_BINS)) binaries to $(PP_INSTALL_PATH)"

install-service: install
	@mkdir -p "$(SYSTEMD_USER_DIR)"; \
	sed 's|@PP_INSTALL_PATH@|$(PP_INSTALL_PATH)|g' primeparts-catalogd.service.in \
	  > "$(SYSTEMD_USER_DIR)/$(CATALOGD_UNIT_NAME)"; \
	echo "installed $(SYSTEMD_USER_DIR)/$(CATALOGD_UNIT_NAME)"; \
	if ! systemctl --user daemon-reload 2>/dev/null; then \
	  echo "no systemd user session; unit written but not enabled — run: systemctl --user enable --now $(CATALOGD_UNIT_NAME)"; \
	elif systemctl --user enable --now $(CATALOGD_UNIT_NAME); then \
	  echo "$(CATALOGD_UNIT_NAME) enabled, running as $$(id -un)"; \
	else \
	  echo "error: failed to enable $(CATALOGD_UNIT_NAME) — check: systemctl --user status $(CATALOGD_UNIT_NAME)" >&2; \
	  exit 1; \
	fi

all: $(BUILD_DIR)/libprimeparts_core.so \
     $(BUILD_DIR)/primeparts-generate \
     $(BUILD_DIR)/pp \
     $(BUILD_DIR)/primeparts-catalogd \
     $(BUILD_DIR)/primeparts-tui \
