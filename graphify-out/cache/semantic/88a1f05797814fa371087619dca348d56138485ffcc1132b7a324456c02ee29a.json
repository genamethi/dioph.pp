{"nodes": [{"id": "markdown_misc_modular_filter_more_ideas_backward_oracle", "label": "Forward-seeded table / backward-search oracle", "file_type": "rationale", "source_file": "markdown/misc/modular_filter_more_ideas.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "For n>=2 the parent q<=sqrt(p) collapses to ~13k primes; precompute q^n into a flat map so n>=2 and large-m become O(1) hits. n=1 is worst case (dynamic Miller-Rabin); mitigate with a sliding-window segmented sieve, sqrt(max_p) precomputed graph, and 2-adic binomial locks (p&7==1 for even n)."}], "edges": [{"source": "markdown_misc_modular_filter_more_ideas_backward_oracle", "target": "markdown_misc_modular_filter_idea_native_filter", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "markdown/misc/modular_filter_more_ideas.md", "source_location": null, "weight": 1.0}, {"source": "markdown_misc_modular_filter_more_ideas_backward_oracle", "target": "native_readme_nt_core", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "markdown/misc/modular_filter_more_ideas.md", "source_location": null, "weight": 1.0}], "hyperedges": []}